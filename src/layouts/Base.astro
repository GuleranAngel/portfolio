---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  center: string;
  home?: boolean;
  ogImage?: string;
  extraFonts?: boolean;
  /** Angel OS: no site header, footer or site script; the page brings its own shell */
  bare?: boolean;
}
const { title, description, center, home = false, ogImage = '/og.jpg', extraFonts = false, bare = false } = Astro.props;
// Clean URLs: /work/pog, not /work/pog.html (Netlify serves both)
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(cleanPath, site.url).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  url: site.url,
  address: { '@type': 'PostalAddress', addressCountry: 'RO' },
  sameAs: [site.behance, site.linkedin],
};
// Content Security Policy for every page (frame-ancestors can't live in a meta tag, so netlify.toml sends that one).
// Scripts and styles stay 'unsafe-inline' because Astro inlines small ones; everything else is this site only,
// plus GIPHY for the GIFs in topped-out.txt.
const CSP = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob: https://*.giphy.com",
  "media-src 'self' blob: https://*.giphy.com",
  "font-src 'self' data:",
  "connect-src 'self'",
  "frame-src 'self'",
  "worker-src 'self' blob:",
  "manifest-src 'self'",
  "form-action 'self'",
  "base-uri 'self'",
  "object-src 'none'"
].join('; ');
// Inside Angel OS a case study opens in a window (an iframe): drop the site chrome there.
// Case study links stay in the window; anything else is handed to the OS.
const EMBED = `(function () {
  if (self === top && !/[?&]embed(=|&|$)/.test(location.search)) return;
  document.documentElement.classList.add('is-embedded');
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href]');
    if (!a || a.target) return;
    var u = new URL(a.href, location.href);
    if (!/^https?:$/.test(u.protocol)) return;
    if (u.origin !== location.origin) { a.target = '_blank'; a.rel = 'noopener'; return; }
    if (u.pathname.indexOf('/work/') === 0 || u.pathname === location.pathname) return;
    // the OS decides: "All work" opens its Work folder, anything else takes the whole tab
    if (self !== top) { e.preventDefault(); top.postMessage({ aos: 'link', href: u.pathname + u.search + u.hash }, location.origin); return; }
    a.target = '_top';
  }, true);
})();`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="viewport" content={bare ? "width=device-width, initial-scale=1, viewport-fit=cover" : "width=device-width, initial-scale=1"} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#070707" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fragment-mono.woff2" as="font" type="font/woff2" crossorigin />
    {extraFonts && <link rel="preload" href="/fonts/poppins-bold.woff2" as="font" type="font/woff2" crossorigin />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Angel Guleran" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {!bare && <script is:inline set:html={EMBED} />}
    <slot name="head" />
  </head>
  <body id="top" class:list={[bare && 'aos']}>
    {!bare && <a class="skip-link" href="#main">Skip to content</a>}
    {!bare && <Header center={center} home={home} />}
    {bare ? <slot /> : <main id="main" tabindex="-1"><slot /></main>}
    {!bare && <Footer />}
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
