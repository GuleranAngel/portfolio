---
// Angel OS: the homepage. The portfolio as a small operating system.
// Desktop browsers get windows, menus and a dock; phones get a home screen with full-screen apps.
// The normal website lives at /site; "Switch to normal website" remembers the choice for the next visit.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { versioned } from '../data/asset-version';
import '../styles/os.css';
import manifest from '../../public/os/work/manifest.json';

// Every module of each Behance presentation, in Behance order (built by the media script into public/os/work)
type Mod = { p: string; n: string; slug: string; title: string; type: 'image' | 'video'; w: number; h: number };
const MODS = manifest as Record<string, Mod>;
function filesOf(id: string) {
  return Object.entries(MODS).filter(([, m]) => m.p === id).sort(([a], [b]) => a.localeCompare(b)).map(([key, m]) => {
    const base = `/os/work/${key}`;
    const th = Math.round((480 * m.h) / m.w);
    return {
      type: m.type, n: m.n, name: `${m.n}-${m.slug}.${m.type === 'video' ? 'mp4' : 'jpg'}`, cap: m.title, w: m.w, h: m.h,
      thumb: versioned(`${base}-t.webp`), tw: 480, th,
      src: versioned(m.type === 'video' ? `${base}.mp4` : `${base}.webp`), poster: versioned(`${base}.webp`)
    };
  });
}

const PROJECTS = [
  { id: 'topout', name: 'Topout', sector: 'Bouldering gym', color: '#ff4b1f', url: '/work/topout',
    desc: 'A brand for a bouldering gym built around Board B, a wall with a light under every hold. The mark, a dot typeface, the app and the screens all come from that one lit hold.' },
  { id: 'atlas', name: 'Atlas Pay', sector: 'Cross-border payments', color: '#3d63ff', url: '/work/atlas-pay',
    desc: 'A payments brand for businesses that move money across borders. The mark is a set of rays from a single origin inside a circle, built to work flat, embossed and lit.' },
  { id: 'pog', name: 'POG', sector: 'Streaming and gaming', color: '#ff005d', url: '/work/pog',
    desc: 'An identity for a streamer and content creator, built around a character with a whole range of reactions, so the brand can react as fast as chat does.' }
].map((p) => ({ ...p, files: filesOf(p.id) }));

const data = {
  person: { name: site.name, role: site.role, base: 'Based in Romania', email: site.email, behance: site.behance, linkedin: site.linkedin },
  normal: '/site',
  projects: PROJECTS,
  walls: {
    'Dot field': { live: true },
    'Atlas light': { video: versioned('/video/atlas-light-reveal-1080.mp4'), poster: versioned('/video/poster/atlas-light-reveal.webp') },
    'POG pattern': { video: versioned('/video/pog-3d-pattern-1080.mp4'), poster: versioned('/video/poster/pog-3d-pattern.webp') }
  }
};
---
<Base
  title="Angel OS | Angel Guleran, brand identity designer"
  description="Angel Guleran is a brand identity designer in Romania. Browse the work as a small desktop, or switch to the normal website."
  center=""
  bare
>
  <Fragment slot="head">
    <script is:inline>
      // Pick the shell before first paint so phones never flash the desktop.
      // People who chose the normal website last time go straight there (/?os brings Angel OS back).
      (function () {
        var d = document.documentElement;
        d.dataset.mode = matchMedia('(max-width: 759px)').matches ? 'phone' : 'desk';
        try {
          var q = new URLSearchParams(location.search);
          if (q.has('os')) localStorage.setItem('aos-pref', 'os');
          else if (localStorage.getItem('aos-pref') === 'site' && !location.hash) location.replace('/site');
        } catch (e) {}
      })();
    </script>
    <link rel="preload" href="/fonts/caveat-700.woff2" as="font" type="font/woff2" crossorigin media="(min-width: 1181px) and (min-height: 701px)" />
  </Fragment>

  <a class="skip" href="#start">Skip to content</a>
  <noscript><p class="noscript">Angel OS needs JavaScript. <a href="/site">Open the normal website</a>.</p></noscript>

  <div class="boot" id="boot" aria-hidden="true">
    <div class="boot__log" id="boot-log"></div>
    <div class="boot__bar" id="boot-bar"></div>
    <p class="boot__skip">Press any key to skip</p>
  </div>

  <div class="desk" id="desk">
    <div class="wall" id="wall" aria-hidden="true"></div>
    <header class="menubar">
      <nav class="menubar__left" aria-label="Menu" id="menubar"></nav>
      <div class="menubar__right">
        <time class="menubar__clock" id="clock"></time>
      </div>
    </header>
    <div class="menu" id="menu" role="menu" hidden></div>
    <main class="windows" id="windows" aria-label="Windows"><span id="start" tabindex="-1"></span></main>
    <nav class="icons" id="icons" aria-label="Desktop"></nav>
    <div class="sticky" id="sticky" aria-hidden="true">hi! click anything, drag the windows around :)</div>
    <nav class="dock" id="dock" aria-label="Dock"></nav>
  </div>

  <div class="phone" id="phone">
    <div class="phone__wall" id="phone-wall" aria-hidden="true"></div>
    <button type="button" class="status" id="status-btn" aria-expanded="false" aria-controls="control" aria-label="Control centre"><time id="phone-clock"></time><span class="status__icons" aria-hidden="true"><i></i><i></i><i></i></span></button>
    <main class="home" id="home">
      <h1 class="sr-only">Angel Guleran, brand identity designer</h1>
      <ul class="springboard" id="springboard" role="list" aria-label="Apps"></ul>
    </main>
    <nav class="phone-dock" id="phone-dock" aria-label="Dock"></nav>
    <div class="sheets" id="sheets"></div>
    <div class="control" id="control" hidden></div>
    <section class="lock" id="lock" aria-label="Lock screen" hidden>
      <p class="lock__date" id="lock-date"></p>
      <p class="lock__time" id="lock-time"></p>
      <div class="lock__notes"></div>
      <button type="button" class="lock__hint" id="lock-hint">Swipe up to open</button>
    </section>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script type="application/json" id="aos-data" set:html={JSON.stringify(data)} />
  <script>
    import '../os/os.js';
  </script>
</Base>
