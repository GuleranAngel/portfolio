---
import Base from '../layouts/Base.astro';
import RegMark from '../components/RegMark.astro';
import { versioned } from '../data/asset-version';
import stills from '../../public/os/gallery/stills.json';
import { buildGallery } from '../data/gallery.mjs';
import '../styles/wall.css';

// The same pieces as gallery.exe in Angel OS, laid out as one wall you drag around
const g = buildGallery(stills, versioned);
const caseTitle = Object.fromEntries(g.cases.map((c) => [c.id, c.title]));
const items = g.items.map((it) => ({
  id: it.id, title: it.title, kind: it.kind, cat: it.cat, year: it.year, where: it.where, set: caseTitle[it.case],
  w: it.w, h: it.h, video: it.video, src: it.src, thumb: it.thumb, mp4: it.mp4, sound: it.sound, hd: it.hd
}));
const groups = g.cats.map((cat) => ({ cat, list: items.filter((it) => it.cat === cat) })).filter((x) => x.list.length);
const count = items.length;
---
<Base
  title="Gallery | Angel Guleran"
  description={`${count} pieces by Angel Guleran, brand identity designer: 3D renders and loops, motion, logos and brand visuals, on one wall you can drag around.`}
  center={`Gallery · ${count} pieces`}
  current="gallery"
  immersive
>
  <div class="wall" data-wall>
    <h1 class="visually-hidden">Gallery</h1>
    <div class="wall__view" data-view tabindex="0" role="region" aria-roledescription="canvas" aria-label={`Gallery wall, ${count} pieces. Drag, scroll or use the arrow keys to move around, and press Enter to open the piece in the middle. The Index button lists every piece.`}>
      <div class="wall__plane" data-plane aria-hidden="true"></div>
    </div>

    <div class="wall__ui">
      <p class="wall__cap label c-grey-2"><RegMark /><span>Loose pieces from ten years of work</span></p>
      <p class="wall__hint label" data-hint aria-hidden="true"><span class="wall__hint-ico"></span>Drag to see more</p>
      <button class="wall__index-btn label" type="button" data-index-open aria-expanded="false" aria-controls="wall-index">Index <span class="c-grey-3">{count}</span></button>
    </div>

    <aside class="wall__index" id="wall-index" aria-labelledby="wall-index-title" hidden data-index>
      <div class="wi__head">
        <h2 class="label" id="wall-index-title">Index · {count} pieces</h2>
        <button class="wi__close label" type="button" data-index-close>Close</button>
      </div>
      <div class="wi__body">
        {groups.map((gr) => (
          <section class="wi__group" aria-label={gr.cat}>
            <h3 class="label c-grey-3">{gr.cat} <span>{gr.list.length}</span></h3>
            <ul>
              {gr.list.map((it) => (
                <li>
                  <button type="button" data-open={it.id}>
                    <img src={it.thumb} alt="" width="48" height={Math.round((48 * it.h) / it.w)} loading="lazy" decoding="async" />
                    <span class="wi__t">{it.title}</span>
                    <span class="wi__k label c-grey-3">{[it.kind, it.year].filter(Boolean).join(' · ')}</span>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </aside>

    <div class="lb" role="dialog" aria-modal="true" aria-labelledby="lb-title" hidden data-lb>
      <div class="lb__stage" data-lb-stage></div>
      <div class="lb__bar">
        <div class="lb__text">
          <h2 class="lb__title" id="lb-title" data-lb-title></h2>
          <p class="lb__meta label c-grey-2" data-lb-meta></p>
        </div>
        <div class="lb__nav">
          <button class="lb__btn" type="button" data-lb-prev aria-label="Previous piece"><span aria-hidden="true">←</span></button>
          <span class="label c-grey-2 lb__count" data-lb-count></span>
          <button class="lb__btn" type="button" data-lb-next aria-label="Next piece"><span aria-hidden="true">→</span></button>
        </div>
      </div>
      <button class="lb__close label" type="button" data-lb-close>Close <span aria-hidden="true">×</span></button>
    </div>

    <noscript>
      <div class="wall__nojs">
        {items.map((it) => <img src={it.thumb} alt={it.title} width={it.w} height={it.h} loading="lazy" />)}
      </div>
    </noscript>
  </div>

  <script type="application/json" id="wall-data" set:html={JSON.stringify(items)} />
  <script>
    import '../scripts/wall.js';
  </script>
</Base>

<style is:global>
  html:has(body.is-immersive), body.is-immersive { height: 100%; overflow: hidden; overscroll-behavior: none; }
  body.is-immersive main { height: 100%; }
</style>

<style>
  /* absolute, not fixed: the lightbox and the index have to sit above the floating header */
  .wall { position: absolute; left: 0; top: 0; width: 100%; height: 100%; height: 100dvh; background: #000; color: var(--white); }
  .wall__index[hidden], .lb[hidden] { display: none; }
  /* the wall itself and its tiles: src/styles/wall.css (shared with gallery.exe in Angel OS) */

  /* overlays */
  .wall__ui { position: absolute; inset: auto 0 0; z-index: 5; display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 16px; padding: 48px var(--pad) 24px; background: linear-gradient(rgba(0,0,0,0), rgba(0,0,0,.7)); pointer-events: none; }
  .wall__cap { display: flex; align-items: center; gap: 12px; margin: 0; }
  .wall__hint { grid-column: 2; display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 10px 16px; border-radius: 999px; background: rgba(20,20,20,.72); border: 1px solid var(--rule); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); color: var(--white); white-space: nowrap; transition: opacity .4s ease; }
  .wall__hint-ico { width: 14px; height: 14px; border: 1px solid currentColor; border-radius: 50%; position: relative; }
  .wall__hint-ico::after { content: ''; position: absolute; inset: 4px; border-radius: 50%; background: currentColor; }
  .wall__index-btn { grid-column: 3; justify-self: end; display: inline-flex; gap: 8px; padding: 10px 16px; border: 1px solid var(--rule); background: rgba(20,20,20,.72); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-radius: 999px; pointer-events: auto; transition: background-color .2s ease, color .2s ease; }
  .wall__index-btn:hover { background: var(--white); color: var(--black); }

  /* the index */
  .wall__index { position: absolute; z-index: 30; top: 0; right: 0; bottom: 0; width: min(420px, 100%); display: flex; flex-direction: column; background: #0b0b0b; border-left: 1px solid var(--rule); }
  .wi__head { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 24px 24px 16px; border-bottom: 1px solid var(--rule); }
  .wi__close { padding: 8px 0 8px 12px; color: var(--grey-2); }
  .wi__close:hover { color: var(--white); }
  .wi__body { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 8px 24px 32px; }
  .wi__group { padding-top: 20px; }
  .wi__group h3 { display: flex; justify-content: space-between; padding-bottom: 8px; }
  .wi__group button { display: grid; grid-template-columns: 48px 1fr; grid-template-rows: auto auto; column-gap: 14px; align-items: center; width: 100%; padding: 8px 0; border-top: 1px solid var(--rule); text-align: left; }
  .wi__group img { grid-row: 1 / 3; width: 48px; height: auto; max-height: 48px; object-fit: contain; object-position: left center; }
  .wi__t { font-size: 15px; line-height: 1.3; }
  .wi__k { font-size: 10px; }
  @media (hover: hover) { .wi__group button:hover .wi__t { color: var(--accent); } }

  /* the lightbox */
  .lb { position: absolute; inset: 0; z-index: 40; display: flex; flex-direction: column; background: #050505; animation: lb-in .25s ease; }
  @keyframes lb-in { from { opacity: 0; } }
  .lb__stage { position: relative; flex: 1; min-height: 0; margin: 72px var(--pad) 0; touch-action: pan-y; }
  .lb__stage :global(img), .lb__stage :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .lb__stage :global(.lb__lo) { filter: blur(6px); transform: scale(.995); }
  .lb__stage :global(.lb__hi) { opacity: 0; transition: opacity .3s ease; }
  .lb__stage :global(.lb__hi.is-in) { opacity: 1; }
  .lb__stage :global(.lb__media) { animation: lb-pop .35s cubic-bezier(.2,.7,.2,1); }
  @keyframes lb-pop { from { opacity: 0; transform: scale(.97); } }
  .lb__bar { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding: 20px var(--pad) 24px; }
  .lb__text { min-width: 0; }
  .lb__title { font-weight: 500; font-size: 22px; line-height: 1.2; letter-spacing: -0.22px; }
  .lb__meta { margin-top: 6px; }
  .lb__nav { display: flex; align-items: center; gap: 14px; flex: none; }
  .lb__count { min-width: 64px; text-align: center; font-variant-numeric: tabular-nums; }
  .lb__btn { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--rule); border-radius: 50%; font-size: 17px; transition: background-color .2s ease, color .2s ease; }
  .lb__btn:hover { background: var(--white); color: var(--black); }
  .lb__close { position: absolute; top: 22px; right: var(--pad); display: inline-flex; gap: 8px; align-items: center; padding: 8px 14px; border: 1px solid var(--rule); border-radius: 999px; background: rgba(20,20,20,.72); }
  .lb__close span { font: 400 16px/1 var(--sans); }
  .lb__close:hover { background: var(--white); color: var(--black); }

  .wall__nojs { position: absolute; inset: 0; z-index: 50; overflow: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; padding: 96px var(--pad) 40px; background: #000; }
  .wall__nojs img { width: 100%; height: auto; }

  @media (max-width: 767px) {
    .wall__ui { grid-template-columns: 1fr auto; padding: 40px 16px 16px; }
    .wall__cap { display: none; }
    .wall__hint { grid-column: 1; justify-self: start; }
    .wall__index-btn { grid-column: 2; }
    .lb__stage { margin: 64px 16px 0; }
    .lb__bar { flex-direction: column; align-items: stretch; gap: 14px; padding: 16px 16px 20px; }
    .lb__nav { justify-content: space-between; }
    .lb__close { top: 14px; right: 16px; }
    .lb__title { font-size: 19px; }
  }
</style>
