---
// Proof sheet / Registration mark (printer's registration mark)
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class:list={['reg', cls]} width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="3.5" stroke="#FF4F1F"/><rect y="6.5" width="14" height="1" fill="#FF4F1F"/><rect x="6.5" width="1" height="14" fill="#FF4F1F"/></svg>
