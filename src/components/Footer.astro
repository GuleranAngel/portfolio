---
import RegMark from './RegMark.astro';
const steps = ['#000000', '#1c1c1c', '#383838', '#555555', '#717171', '#8e8e8e', '#c6c6c6', '#ffffff'];
---
<footer class="site-footer">
  <div class="ftr wrap">
    <div class="wedge" aria-hidden="true">
      <RegMark />
      <span class="gap"></span>
      {steps.map((c) => <span class="step" style={`background:${c}`}></span>)}
      <span class="step accent"></span>
    </div>
    <p class="label c-grey-3 file">Guleran_ANGEL_Portfolio_2026</p>
    <div class="copy">
      <p class="label c-grey-3">© 2026 Angel Guleran</p>
      <RegMark />
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--rule); }
  .ftr { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-top: 20px; padding-bottom: 24px; }
  .wedge { display: flex; align-items: center; }
  .wedge .gap { width: 10px; }
  .step { width: 22px; height: 10px; border: 1px solid var(--rule); }
  .step.accent { background: var(--accent); border: 0; }
  .copy { display: flex; align-items: center; gap: 12px; }
  @media (max-width: 767px) {
    .ftr { flex-direction: column; align-items: flex-start; gap: 14px; padding-top: 18px; }
    .file { display: none; }
    .copy :global(.reg) { display: none; }
  }
</style>
